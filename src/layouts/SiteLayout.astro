---
import { NAV_ITEMS, SITE } from '../config/site';
import '../styles/global.css';
import type { SiteLayoutProps } from '../types/site';

const {
  title,
  description,
  activeRoute,
  canonicalPath,
  skipTarget = '#main-content',
} = Astro.props as SiteLayoutProps;

const canonicalUrl = new URL(canonicalPath, SITE.origin);
const socialImageUrl = new URL('/og.png', SITE.origin);
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1e6b3f" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={socialImageUrl.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1731" />
    <meta property="og:image:height" content="909" />
    <meta property="og:image:alt" content="Desa Kentengsari di lereng Gunung Sumbing" />
    <meta property="og:locale" content={SITE.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl.href} />
    <meta name="twitter:image:alt" content="Desa Kentengsari di lereng Gunung Sumbing" />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="icon" type="image/png" href="/assets/kentengsari-logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class:list={[activeRoute === 'profil-desa' && 'profile-route']}>
    <a
      class="fixed left-3 top-3 z-[200] -translate-y-[160%] rounded-lg bg-white px-4 py-3 font-extrabold text-kenteng-950 shadow-raised transition-transform focus:translate-y-0"
      href={skipTarget}
    >
      Lewati ke konten utama
    </a>

    <header class="site-header" data-site-header data-scrolled="false">
      <div class="site-header__inner">
        <a class="site-header__brand" href="/index.html">
          <img
            class="site-header__logo"
            src="/assets/kentengsari-logo.png"
            alt="Logo Desa Kentengsari"
            width="48"
            height="48"
          />
          <span>{SITE.shortName}</span>
        </a>

        <button
          class="site-header__toggle"
          type="button"
          aria-controls="site-navigation"
          aria-expanded="false"
          aria-label="Buka menu navigasi"
          data-nav-toggle
        >
          <svg class="site-menu-icon" data-menu-icon aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
            <path class="site-menu-icon__line site-menu-icon__line--top" data-menu-icon-line="top" d="M4 7h16" />
            <path class="site-menu-icon__line site-menu-icon__line--middle" data-menu-icon-line="middle" d="M4 12h16" />
            <path class="site-menu-icon__line site-menu-icon__line--bottom" data-menu-icon-line="bottom" d="M4 17h16" />
          </svg>
        </button>

        <nav
          id="site-navigation"
          class="site-nav"
          aria-label="Navigasi utama"
          data-site-nav
          data-open="false"
        >
          {
            NAV_ITEMS.map((item) => (
              <a
                href={item.href}
                aria-current={item.id === activeRoute ? 'page' : undefined}
                class:list={[
                  'site-nav__link',
                  item.id === activeRoute
                    ? 'site-nav__link--active'
                    : '',
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <slot />

    <footer class:list={['bg-kenteng-950 text-white/80', activeRoute === 'profil-desa' && 'profile-site-footer']}>
      <div class="mx-auto grid w-[min(1120px,calc(100%-2rem))] gap-10 py-14 md:grid-cols-2 lg:grid-cols-4">
        <div>
          <img
            class="mb-4 h-14 w-14 object-contain"
            src="/assets/kentengsari-logo.png"
            alt="Logo Desa Kentengsari"
            width="56"
            height="56"
            loading="lazy"
          />
          <p class="text-sm leading-7">
            Website resmi Desa Kentengsari — media informasi, transparansi, dan komunikasi antara pemerintah desa dan masyarakat.
          </p>
        </div>
        <div>
          <h2 class="mb-4 font-extrabold text-white">Desa Kentengsari</h2>
          <ul class="grid gap-2 text-sm">
            {NAV_ITEMS.slice(0, 4).map((item) => <li><a class="hover:text-white" href={item.href}>{item.label}</a></li>)}
          </ul>
        </div>
        <div>
          <h2 class="mb-4 font-extrabold text-white">Media &amp; Informasi</h2>
          <ul class="grid gap-2 text-sm">
            {NAV_ITEMS.slice(4).map((item) => <li><a class="hover:text-white" href={item.href}>{item.label}</a></li>)}
          </ul>
        </div>
        <div>
          <h2 class="mb-4 font-extrabold text-white">Alamat</h2>
          <address class="text-sm not-italic leading-7">
            {SITE.address.map((line) => <>{line}<br /></>)}
          </address>
          <a class="mt-3 inline-block break-all text-sm font-bold text-kenteng-100 hover:text-white" href={`mailto:${SITE.email}`}>
            {SITE.email}
          </a>
        </div>
      </div>
      <div class="border-t border-white/15 py-5">
        <div class="mx-auto flex w-[min(1120px,calc(100%-2rem))] flex-wrap justify-between gap-3 text-xs text-white/60">
          <p>© <span data-current-year>{new Date().getFullYear()}</span> Pemerintah Desa Kentengsari. Hak cipta dilindungi undang-undang.</p>
          <p>Dikembangkan dengan semangat gotong royong.</p>
        </div>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
      const navigation = document.querySelector<HTMLElement>('[data-site-nav]');

      const setNavigation = (open: boolean) => {
        if (!toggle || !navigation) return;
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Tutup menu navigasi' : 'Buka menu navigasi');
        navigation.dataset.open = String(open);
        document.body.classList.toggle('site-menu-open', open);
      };

      const updateHeader = () => {
        const header = document.querySelector<HTMLElement>('[data-site-header]');
        if (header) header.dataset.scrolled = String(window.scrollY > 40);
      };

      toggle?.addEventListener('click', () => {
        setNavigation(toggle.getAttribute('aria-expanded') !== 'true');
      });

      navigation?.addEventListener('click', (event) => {
        if ((event.target as Element).closest('a')) setNavigation(false);
        else if (event.target === navigation) {
          setNavigation(false);
          toggle?.focus();
        }
      });

      window.addEventListener('resize', () => {
        if (window.innerWidth >= 861) setNavigation(false);
      });

      updateHeader();
      window.addEventListener('scroll', updateHeader, { passive: true });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
          setNavigation(false);
          toggle.focus();
        }
      });
    </script>
  </body>
</html>

<style is:global>
  .profile-route .site-header__inner {
    min-height: 96px;
  }

  .profile-route .site-nav {
    gap: 0;
  }

  .profile-route .site-nav__link {
    padding-inline: 0.58rem;
    font-size: 0.75rem;
  }

  .profile-route .profile-site-footer {
    color: #5f6f7c;
    background: #e8f0f5;
  }

  .profile-route .profile-site-footer > div:first-child {
    padding-block: 3.25rem;
    gap: 2rem;
  }

  .profile-route .profile-site-footer h2 {
    color: #283a47;
    font-size: 0.9rem;
  }

  .profile-route .profile-site-footer a:hover {
    color: #275d59;
  }

  .profile-route .profile-site-footer a[href^='mailto:'] {
    color: #326d69;
  }

  .profile-route .profile-site-footer > div:last-child {
    border-color: rgb(53 80 95 / 0.16);
  }

  .profile-route .profile-site-footer > div:last-child > div {
    color: #75838d;
  }

  @media (max-width: 860px) {
    .profile-route .site-header__inner {
      min-height: 80px;
    }

    .site-nav[data-open='true'] {
      display: flex;
    }

    .profile-route .profile-site-footer > div:first-child {
      padding-block: 2.75rem;
    }
  }

  @media (max-width: 639px) {
    .profile-route .profile-site-footer > div:first-child {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem 1rem;
    }

    .profile-route .profile-site-footer > div:first-child > div:first-child,
    .profile-route .profile-site-footer > div:first-child > div:last-child {
      grid-column: 1 / -1;
    }

    .profile-route .profile-site-footer p,
    .profile-route .profile-site-footer address,
    .profile-route .profile-site-footer a {
      font-size: 0.75rem;
    }
  }
</style>
