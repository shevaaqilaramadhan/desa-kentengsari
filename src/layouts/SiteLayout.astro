---
import { NAV_ITEMS, SITE } from '../config/site';
import '../styles/global.css';
import type { SiteLayoutProps } from '../types/site';

const {
  title,
  description,
  activeRoute,
  canonicalPath,
  skipTarget = '#main-content',
} = Astro.props as SiteLayoutProps;

const canonicalUrl = new URL(canonicalPath, SITE.origin);
const socialImageUrl = new URL('/og.png', SITE.origin);
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1e6b3f" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={socialImageUrl.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1731" />
    <meta property="og:image:height" content="909" />
    <meta property="og:image:alt" content="Desa Kentengsari di lereng Gunung Sumbing" />
    <meta property="og:locale" content={SITE.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl.href} />
    <meta name="twitter:image:alt" content="Desa Kentengsari di lereng Gunung Sumbing" />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="icon" type="image/png" href="/assets/kentengsari-logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <a
      class="fixed left-3 top-3 z-[200] -translate-y-[160%] rounded-lg bg-white px-4 py-3 font-extrabold text-kenteng-950 shadow-raised transition-transform focus:translate-y-0"
      href={skipTarget}
    >
      Lewati ke konten utama
    </a>

    <header class="sticky top-0 z-50 border-b border-line bg-white/95 backdrop-blur" data-site-header>
      <div class="mx-auto flex min-h-20 w-[min(1120px,calc(100%-2rem))] items-center justify-between gap-5">
        <a class="flex items-center gap-3 font-extrabold text-kenteng-950" href="/index.html">
          <img
            class="h-12 w-12 object-contain"
            src="/assets/kentengsari-logo.png"
            alt="Logo Desa Kentengsari"
            width="48"
            height="48"
          />
          <span>{SITE.shortName}</span>
        </a>

        <button
          class="grid min-h-11 min-w-11 place-items-center rounded-lg border border-kenteng-100 text-kenteng-900 md:hidden"
          type="button"
          aria-controls="site-navigation"
          aria-expanded="false"
          aria-label="Buka menu navigasi"
          data-nav-toggle
        >
          <span aria-hidden="true" class="text-2xl leading-none">☰</span>
        </button>

        <nav
          id="site-navigation"
          class="site-nav absolute inset-x-0 top-full hidden max-h-[calc(100vh-5rem)] flex-col gap-1 overflow-y-auto border-b border-line bg-white p-4 shadow-card md:static md:flex md:max-h-none md:flex-row md:items-center md:border-0 md:bg-transparent md:p-0 md:shadow-none"
          aria-label="Navigasi utama"
          data-site-nav
          data-open="false"
        >
          {
            NAV_ITEMS.map((item) => (
              <a
                href={item.href}
                aria-current={item.id === activeRoute ? 'page' : undefined}
                class:list={[
                  'rounded-lg px-3 py-2 text-sm font-bold transition-colors',
                  item.id === activeRoute
                    ? 'bg-kenteng-50 text-kenteng-800'
                    : 'text-ink hover:bg-kenteng-50 hover:text-kenteng-800',
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <slot />

    <footer class="bg-kenteng-950 text-white/80">
      <div class="mx-auto grid w-[min(1120px,calc(100%-2rem))] gap-10 py-14 md:grid-cols-2 lg:grid-cols-4">
        <div>
          <img
            class="mb-4 h-14 w-14 object-contain"
            src="/assets/kentengsari-logo.png"
            alt="Logo Desa Kentengsari"
            width="56"
            height="56"
            loading="lazy"
          />
          <p class="text-sm leading-7">
            Website resmi Desa Kentengsari — media informasi, transparansi, dan komunikasi antara pemerintah desa dan masyarakat.
          </p>
        </div>
        <div>
          <h2 class="mb-4 font-extrabold text-white">Desa Kentengsari</h2>
          <ul class="grid gap-2 text-sm">
            {NAV_ITEMS.slice(0, 4).map((item) => <li><a class="hover:text-white" href={item.href}>{item.label}</a></li>)}
          </ul>
        </div>
        <div>
          <h2 class="mb-4 font-extrabold text-white">Media &amp; Informasi</h2>
          <ul class="grid gap-2 text-sm">
            {NAV_ITEMS.slice(4).map((item) => <li><a class="hover:text-white" href={item.href}>{item.label}</a></li>)}
          </ul>
        </div>
        <div>
          <h2 class="mb-4 font-extrabold text-white">Alamat</h2>
          <address class="text-sm not-italic leading-7">
            {SITE.address.map((line) => <>{line}<br /></>)}
          </address>
          <a class="mt-3 inline-block break-all text-sm font-bold text-kenteng-100 hover:text-white" href={`mailto:${SITE.email}`}>
            {SITE.email}
          </a>
        </div>
      </div>
      <div class="border-t border-white/15 py-5">
        <div class="mx-auto flex w-[min(1120px,calc(100%-2rem))] flex-wrap justify-between gap-3 text-xs text-white/60">
          <p>© <span data-current-year>{new Date().getFullYear()}</span> Pemerintah Desa Kentengsari. Hak cipta dilindungi undang-undang.</p>
          <p>Dikembangkan dengan semangat gotong royong.</p>
        </div>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
      const navigation = document.querySelector<HTMLElement>('[data-site-nav]');

      const setNavigation = (open: boolean) => {
        if (!toggle || !navigation) return;
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Tutup menu navigasi' : 'Buka menu navigasi');
        navigation.dataset.open = String(open);
      };

      toggle?.addEventListener('click', () => {
        setNavigation(toggle.getAttribute('aria-expanded') !== 'true');
      });

      navigation?.addEventListener('click', (event) => {
        if ((event.target as Element).closest('a')) setNavigation(false);
      });

      window.addEventListener('resize', () => {
        if (window.innerWidth >= 768) setNavigation(false);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
          setNavigation(false);
          toggle.focus();
        }
      });
    </script>
  </body>
</html>

<style is:global>
  @media (max-width: 767px) {
    .site-nav[data-open='true'] {
      display: flex;
    }
  }
</style>
