  activeRoute="destinasi"
  canonicalPath="/destinasi.html"
>
  <main id="main-content" class="bg-surface-soft py-24">
    <div class="mx-auto w-[min(1120px,calc(100%-2rem))]">
      <FoundationPlaceholder eyebrow="Checkpoint migrasi" heading="Destinasi Desa Kentengsari" />
    </div>
  </main>
</SiteLayout>
