---
import InfoCard from '../components/astro/InfoCard.astro';
import PageHero from '../components/astro/PageHero.astro';
import SectionHeading from '../components/astro/SectionHeading.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const administrativeAreas = [
  ['Kentengsari 1', 'Nama kewilayahan administratif pemerintah desa setelah mengikuti peraturan bupati baru.'],
  ['Kentengsari 2', 'Nama kewilayahan administratif pemerintah desa setelah mengikuti peraturan bupati baru.'],
] as const;

const communityNames = [
  ['Nglarangan', 'Sebutan dusun yang tetap hidup dan digunakan dalam keseharian warga.'],
  ['Kentengsari', 'Sebutan dusun yang tetap hidup dan digunakan dalam keseharian warga.'],
  ['Kenteng Wetan', 'Sebutan dusun yang tetap hidup dan digunakan dalam keseharian warga.'],
] as const;
---

<SiteLayout title="Dusun — Desa Kentengsari" description="Pembagian wilayah Desa Kentengsari: dua wilayah administratif Kentengsari 1 dan Kentengsari 2, serta tiga sebutan dusun warga." activeRoute="dusun" canonicalPath="/dusun.html">
  <main id="main-content">
    <PageHero current="Dusun" title="Wilayah Desa Kentengsari" description="Memahami nama administratif pemerintah, sebutan dusun warga, dan riwayat penataan wilayah secara tepat." />
    <section class="bg-surface-soft py-20 md:py-28">
      <div class="mx-auto w-[min(1120px,calc(100%-2rem))]">
        <SectionHeading centered eyebrow="Administratif Pemerintah" title="Dua Wilayah Kewilayahan" description="Setelah mengikuti peraturan bupati baru, nama kewilayahan administratif pemerintah Desa Kentengsari adalah Kentengsari 1 dan Kentengsari 2." />
        <div class="mx-auto mt-10 grid max-w-3xl gap-5 md:grid-cols-2">{administrativeAreas.map(([title, description]) => <InfoCard title={title} description={description} />)}</div>
      </div>
    </section>
    <section class="py-20 md:py-28">
      <div class="mx-auto w-[min(1120px,calc(100%-2rem))]">
        <SectionHeading centered eyebrow="Sebutan yang Hidup di Warga" title="Tiga Sebutan Dusun" description="Nglarangan, Kentengsari, dan Kenteng Wetan tetap dipakai warga dalam kehidupan sehari-hari. Sebutan sosial ini tidak bertentangan dengan dua wilayah administratif pemerintah karena konteks penggunaannya berbeda." />
        <div class="mt-10 grid gap-5 md:grid-cols-3">{communityNames.map(([title, description]) => <InfoCard title={title} description={description} />)}</div>
        <aside class="mx-auto mt-8 max-w-4xl rounded-card border-l-4 border-kenteng-600 bg-kenteng-50 p-6 leading-7 text-muted" aria-label="Riwayat penataan wilayah">
          <strong class="text-kenteng-950">Riwayat sebelum penataan organisasi desa:</strong> wilayah pernah dinyatakan sebagai Krajan 1, Krajan 2, dan Krajan 3. Ketiganya dicatat sebagai riwayat dan bukan nama kewilayahan administratif yang berlaku saat ini.
        </aside>
      </div>
    </section>
    <section class="bg-surface-soft py-20 md:py-28">
      <div class="mx-auto grid w-[min(1120px,calc(100%-2rem))] items-center gap-12 lg:grid-cols-2">
        <div>
          <SectionHeading eyebrow="Kehidupan Bermasyarakat" title="Nama Berbeda, Satu Kentengsari" description="Pembagian administratif membantu penyelenggaraan pemerintahan, sedangkan sebutan dusun menjaga kedekatan identitas warga. Kegiatan gotong royong, kerja bakti, dan pertemuan warga tetap menjadi perekat kebersamaan Desa Kentengsari." />
          <a class="mt-7 inline-flex rounded-full bg-kenteng-700 px-6 py-3 font-extrabold text-white hover:bg-kenteng-800" href="/galeri.html">Lihat Dokumentasi Kegiatan</a>
        </div>
        <img class="h-[390px] w-full rounded-panel object-cover shadow-raised" src="/assets/kata-sambutan-2.jpg" alt="Kegiatan bersama masyarakat dusun di Desa Kentengsari" loading="lazy" />
      </div>
    </section>
  </main>
</SiteLayout>
