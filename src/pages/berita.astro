---
import PageHero from '../components/astro/PageHero.astro';
import SectionHeading from '../components/astro/SectionHeading.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Berita — Desa Kentengsari" description="Berita dan informasi terbaru seputar kegiatan, pembangunan, dan kehidupan masyarakat Desa Kentengsari, Kecamatan Windusari, Kabupaten Magelang." activeRoute="berita" canonicalPath="/berita.html">
  <main id="main-content">
    <PageHero current="Berita" title="Berita Desa" description="Kabar terbaru seputar kegiatan, pembangunan, dan kehidupan masyarakat Desa Kentengsari." />
    <section class="bg-surface-soft py-20 md:py-28">
      <div class="mx-auto w-[min(1120px,calc(100%-2rem))]">
        <SectionHeading centered eyebrow="Kabar Terbaru" title="Informasi & Kegiatan Desa" description="Seluruh berita resmi yang diterbitkan oleh Pemerintah Desa Kentengsari akan tampil di halaman ini." />
        <div class="mx-auto mt-10 max-w-2xl rounded-panel border border-line bg-white p-10 text-center shadow-card">
          <div class="mx-auto grid h-16 w-16 place-items-center rounded-full bg-kenteng-50 text-kenteng-700">
            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/><path d="M18 14h-8M15 18h-5M10 6h8v4h-8V6Z"/></svg>
          </div>
          <h3 class="mt-5 text-xl font-extrabold text-kenteng-950">Belum Ada Berita</h3>
          <p class="mt-2 leading-7 text-muted">Informasi dan berita seputar kegiatan Desa Kentengsari akan segera hadir. Silakan kunjungi kembali halaman ini atau hubungi kantor desa untuk informasi terkini.</p>
        </div>
        <div class="mt-8 text-center"><a class="inline-flex rounded-full bg-kenteng-700 px-6 py-3 font-extrabold text-white hover:bg-kenteng-800" href="/kontak.html">Hubungi Kantor Desa</a></div>
      </div>
    </section>
  </main>
</SiteLayout>
