---
import SiteLayout from '../layouts/SiteLayout.astro';

const stats = [
  { value: '1.201', label: 'Total Penduduk' },
  { value: '626', label: 'Pria' },
  { value: '575', label: 'Wanita' },
  { value: '390', label: 'Kepala Keluarga' },
] as const;

const missions = [
  'Meningkatkan kualitas pelayanan publik yang transparan, cepat, dan akuntabel.',
  'Mengembangkan pertanian dan ekonomi produktif sebagai tulang punggung kesejahteraan warga.',
  'Memperkuat kerukunan, gotong royong, dan kearifan lokal dalam kehidupan bermasyarakat.',
  'Melestarikan lingkungan serta potensi alam lereng Gunung Sumbing.',
  'Meningkatkan kualitas sumber daya manusia melalui pendidikan dan pemberdayaan pemuda.',
] as const;

const facilities = [
  'Kantor Desa',
  'Sekolah Dasar',
  'Tempat Ibadah',
  'Lahan Pertanian',
  'Drainase & Irigasi',
] as const;

const landmarkImages = [
  { src: '/assets/galeri-3.jpg', alt: 'Panorama alam Desa Kentengsari dari ketinggian' },
  { src: '/assets/galeri-1.jpg', alt: 'Hamparan hijau persawahan Desa Kentengsari' },
  { src: '/assets/kata-sambutan-2.jpg', alt: 'Kegiatan gotong royong masyarakat Kentengsari' },
] as const;
---

<SiteLayout
  title="Profil Desa — Desa Kentengsari"
  description="Profil Desa Kentengsari: data penduduk 2025, dua wilayah administratif, tiga sebutan dusun warga, sejarah, dan struktur pemerintahan desa."
  activeRoute="profil-desa"
  canonicalPath="/profil-desa.html"
>
  <main id="main-content" class="profile-page">
    <section class="profile-hero" data-page-hero aria-labelledby="profile-title">
      <img
        src="/assets/hero-background.jpg"
        alt="Pemandangan Desa Kentengsari di lereng Gunung Sumbing"
        class="profile-hero__image"
      />
      <div class="profile-hero__overlay" aria-hidden="true"></div>
      <div class="profile-container profile-hero__content">
        <h1 id="profile-title">Jelajahi Kisah Menakjubkan Desa Kentengsari</h1>
        <p>Mengenal perjalanan, ruang hidup, dan semangat warga di lereng Gunung Sumbing.</p>
      </div>
    </section>

    <section class="profile-history" id="sejarah" aria-labelledby="history-title">
      <div class="profile-container profile-history__layout">
        <div class="profile-history__content">
          <p class="profile-eyebrow">Cerita Desa Kentengsari</p>
          <h2 id="history-title">Awal Dari Perjalanan Kami</h2>
          <p>
            Nama Desa Kentengsari lahir dari penggabungan Desa Kenteng dan Desa Sari. Sejak itu,
            keduanya tumbuh menjadi satu wilayah administratif di Kecamatan Windusari, Kabupaten
            Magelang.
          </p>
          <p>
            Berada di lereng Gunung Sumbing, Kentengsari dianugerahi udara sejuk dan tanah subur
            yang menopang pertanian padi, tembakau, sayuran, serta kehidupan warga yang erat dengan
            semangat gotong royong.
          </p>

          <div class="profile-territory" id="wilayah" aria-label="Konteks pembagian wilayah Desa Kentengsari">
            <article>
              <strong>2 wilayah administratif</strong>
              <p>Kentengsari 1 dan Kentengsari 2 adalah nama kewilayahan yang berlaku saat ini.</p>
            </article>
            <article>
              <strong>3 sebutan warga</strong>
              <ul aria-label="Sebutan dusun warga">
                <li>Nglarangan</li>
                <li>Kentengsari</li>
                <li>Kenteng Wetan</li>
              </ul>
            </article>
            <p class="profile-territory__history">
              Sebelum penataan organisasi desa, wilayah pernah disebut Krajan 1, Krajan 2, dan
              Krajan 3. Catatan ini merupakan riwayat, bukan pembagian administratif yang berlaku.
            </p>
          </div>

          <div class="profile-stats" id="statistik" aria-label="Data penduduk Desa Kentengsari tahun 2025">
            {stats.map((stat) => (
              <article>
                <strong>{stat.value}</strong>
                <h3>{stat.label}</h3>
              </article>
            ))}
          </div>
        </div>

        <figure class="profile-history__visual">
          <img
            src="/assets/profil-desa-image.jpg"
            alt="Panorama wilayah Desa Kentengsari di lereng Gunung Sumbing"
            loading="lazy"
          />
        </figure>
      </div>
    </section>

    <section class="profile-landmark" id="landmark" aria-labelledby="landmark-title">
      <div class="profile-container profile-landmark__layout">
        <div class="profile-landmark__collage" data-profile-landmark-gallery aria-label="Galeri ruang hidup Kentengsari">
          {landmarkImages.map((image, index) => (
            <figure class={`profile-landmark__image profile-landmark__image--${index + 1}`}>
              <img src={image.src} alt={image.alt} loading="lazy" />
            </figure>
          ))}
        </div>
        <div class="profile-landmark__content">
          <p class="profile-eyebrow">Ruang Hidup Bersama</p>
          <h2 id="landmark-title">Landmark &amp; Sarana Desa</h2>
          <p>
            Alam, lahan produktif, dan fasilitas publik bertemu dalam keseharian Kentengsari.
            Seluruhnya mendukung pelayanan, pendidikan, kegiatan rohani, serta mata pencaharian
            masyarakat desa.
          </p>
          <ul class="profile-facilities" aria-label="Daftar sarana Desa Kentengsari">
            {facilities.map((facility) => <li>{facility}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="profile-vision" id="visi-misi" aria-labelledby="vision-title">
      <div class="profile-container">
        <p class="profile-eyebrow profile-eyebrow--center">Arah Pembangunan</p>
        <h2 id="vision-title">Visi &amp; Misi Kita</h2>
        <div class="profile-vision__cards">
          <article class="profile-vision__card">
            <span>Visi</span>
            <h3>Desa yang maju, mandiri, dan sejahtera</h3>
            <p>
              Berlandaskan gotong royong serta kearifan lokal masyarakat lereng Gunung Sumbing.
            </p>
          </article>
          <article class="profile-vision__card profile-vision__card--mission">
            <span>Misi</span>
            <ol>
              {missions.map((mission) => <li>{mission}</li>)}
            </ol>
          </article>
        </div>
      </div>
    </section>

    <section class="profile-structure" id="struktur" aria-labelledby="structure-title">
      <div class="profile-container">
        <p class="profile-eyebrow profile-eyebrow--center">Pemerintahan Desa</p>
        <h2 id="structure-title">Struktur Organisasi Desa</h2>
        <p class="profile-structure__intro">
          Bagan fungsi pemerintahan tanpa mencantumkan nama pejabat yang belum terverifikasi.
        </p>

        <div class="profile-org" role="group" aria-label="Bagan hierarki pemerintahan Desa Kentengsari">
          <article class="profile-org__head">
            <span>Pimpinan</span>
            <h3>Kepala Desa</h3>
          </article>
          <div class="profile-org__line profile-org__line--stem" aria-hidden="true"></div>
          <div class="profile-org__branches">
            <article>
              <span>Administrasi</span>
              <h3>Sekretaris Desa</h3>
              <p>Koordinasi administrasi pemerintahan.</p>
            </article>
            <article>
              <span>Pelaksana Teknis</span>
              <h3>Kaur &amp; Kasi</h3>
              <p>Unsur urusan dan seksi pelayanan teknis.</p>
            </article>
            <article class="profile-org__territory">
              <span>Pelaksana Kewilayahan</span>
              <h3>Kepala Kewilayahan</h3>
              <div>
                <p>Kentengsari 1</p>
                <p>Kentengsari 2</p>
              </div>
            </article>
          </div>
        </div>

        <div class="profile-structure__notes">
          <aside>
            <strong>Sebutan warga</strong>
            <p>Nglarangan, Kentengsari, dan Kenteng Wetan tetap hidup dalam percakapan sehari-hari.</p>
          </aside>
          <aside>
            <strong>Catatan riwayat</strong>
            <p>Krajan 1, Krajan 2, dan Krajan 3 adalah sebutan sebelum penataan organisasi desa.</p>
          </aside>
        </div>
      </div>
    </section>
  </main>
</SiteLayout>

<style>
  .profile-page {
    overflow: clip;
    color: #24313d;
    background: #fff;
    font-family: var(--font-sans);
  }

  .profile-container {
    width: min(1100px, calc(100% - 3rem));
    margin-inline: auto;
  }

  .profile-hero {
    position: relative;
    display: flex;
    height: 100svh;
    height: 100dvh;
    min-height: 560px;
    align-items: flex-end;
    isolation: isolate;
    overflow: hidden;
    color: #fff;
    background: #163c3a;
    text-align: left;
  }

  .profile-hero__image,
  .profile-hero__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .profile-hero__image {
    z-index: -2;
    object-fit: cover;
    object-position: center;
  }

  .profile-hero__overlay {
    z-index: -1;
    background:
      linear-gradient(90deg, rgb(10 44 51 / 0.72) 0%, rgb(10 54 47 / 0.38) 58%, rgb(10 40 45 / 0.17) 100%),
      linear-gradient(0deg, rgb(8 30 35 / 0.46) 0%, transparent 52%);
  }

  .profile-hero__content {
    padding-bottom: clamp(5.5rem, 14vh, 9.5rem);
  }

  .profile-hero h1 {
    max-width: 850px;
    margin: 0;
    font-size: clamp(3.4rem, 6.2vw, 6.15rem);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.052em;
  }

  .profile-hero p {
    max-width: 600px;
    margin: 1.5rem 0 0;
    color: rgb(255 255 255 / 0.86);
    font-size: clamp(1rem, 1.5vw, 1.18rem);
    line-height: 1.7;
  }

  .profile-eyebrow {
    margin: 0 0 1rem;
    color: #367a70;
    font-size: 0.73rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .profile-eyebrow--center {
    text-align: center;
  }

  .profile-history,
  .profile-landmark,
  .profile-vision,
  .profile-structure {
    scroll-margin-top: 96px;
  }

  .profile-history {
    padding: clamp(4.5rem, calc(2.2143rem + 4.7619vw), 6.5rem) 0;
    background: #fff;
  }

  .profile-history__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.06fr) minmax(320px, 0.76fr);
    gap: clamp(2.5rem, calc(-0.3571rem + 5.9524vw), 5rem);
    align-items: start;
  }

  .profile-history h2,
  .profile-landmark h2,
  .profile-vision h2,
  .profile-structure h2 {
    margin: 0;
    color: #263542;
    font-size: clamp(2.4rem, 4.6vw, 4.15rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.048em;
  }

  .profile-history__content > p:not(.profile-eyebrow),
  .profile-landmark__content > p:not(.profile-eyebrow) {
    margin: 1.35rem 0 0;
    color: #65727e;
    font-size: 0.97rem;
    line-height: 1.85;
  }

  .profile-history__visual {
    margin: 0;
  }

  .profile-history__visual img {
    width: 100%;
    height: clamp(34rem, calc(23.4857rem + 21.9048vw), 43.75rem);
    object-fit: cover;
    object-position: center;
    border-radius: 2px;
  }

  .profile-territory {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .profile-territory article,
  .profile-territory__history {
    padding: 1rem 1.1rem;
    border: 1px solid #dce7e8;
    background: #f5f9fa;
  }

  .profile-territory strong {
    color: #294d50;
    font-size: 0.82rem;
  }

  .profile-territory article p,
  .profile-territory li,
  .profile-territory__history {
    color: #6a7780;
    font-size: 0.73rem;
    line-height: 1.6;
  }

  .profile-territory article p {
    margin: 0.35rem 0 0;
  }

  .profile-territory ul {
    display: flex;
    margin: 0.35rem 0 0;
    padding: 0;
    flex-wrap: wrap;
    gap: 0 0.85rem;
    list-style: none;
  }

  .profile-territory__history {
    grid-column: 1 / -1;
    margin: 0;
  }

  .profile-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.65rem;
    margin-top: 1.75rem;
  }

  .profile-stats article {
    min-width: 0;
    padding: 1rem 0.8rem;
    border: 1px solid #dce7e8;
    background: #fff;
  }

  .profile-stats strong {
    display: block;
    color: #275d59;
    font-size: clamp(1.45rem, 2.5vw, 2rem);
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .profile-stats h3 {
    margin: 0.65rem 0 0;
    color: #687681;
    font-size: 0.66rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .profile-landmark {
    padding: clamp(4.25rem, calc(1.9643rem + 4.7619vw), 6.25rem) 0;
    background: #fff;
  }

  .profile-landmark__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.82fr);
    gap: clamp(2.5rem, calc(-0.3571rem + 5.9524vw), 5rem);
    align-items: center;
  }

  .profile-landmark__collage {
    display: grid;
    height: clamp(34rem, calc(27.1429rem + 14.2857vw), 40rem);
    grid-template-columns: 1.18fr 0.82fr;
    grid-template-rows: 1fr 0.9fr;
    gap: 0.8rem;
  }

  .profile-landmark__image {
    min-width: 0;
    margin: 0;
    overflow: hidden;
  }

  .profile-landmark__image--1 {
    grid-row: 1 / -1;
  }

  .profile-landmark__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .profile-facilities {
    display: flex;
    margin: 1.75rem 0 0;
    padding: 0;
    flex-wrap: wrap;
    gap: 0.65rem;
    list-style: none;
  }

  .profile-facilities li {
    padding: 0.62rem 0.9rem;
    border: 1px solid #cfdfe1;
    border-radius: 999px;
    color: #385c60;
    background: #f7fafb;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .profile-vision {
    padding: clamp(4.5rem, calc(2.7857rem + 3.5714vw), 6rem) 0;
    background: #eaf3f8;
  }

  .profile-vision > .profile-container > h2,
  .profile-structure > .profile-container > h2 {
    text-align: center;
  }

  .profile-vision__cards {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 1.5rem;
    margin-top: clamp(2.75rem, calc(2.4643rem + 0.5952vw), 3rem);
  }

  .profile-vision__card {
    padding: 2.5rem;
    border: 1px solid #d7e4e8;
    background: #fff;
  }

  .profile-vision__card > span {
    color: #38776f;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .profile-vision__card h3 {
    margin: 1.4rem 0 1rem;
    color: #2b3c47;
    font-size: clamp(1.75rem, 3vw, 2.65rem);
    line-height: 1.2;
    letter-spacing: -0.04em;
  }

  .profile-vision__card p,
  .profile-vision__card li {
    color: #64727d;
    font-size: 0.84rem;
    line-height: 1.7;
  }

  .profile-vision__card p {
    margin: 0;
  }

  .profile-vision__card ol {
    display: grid;
    margin: 1.15rem 0 0;
    padding: 0;
    gap: 0;
    list-style: none;
    counter-reset: mission;
  }

  .profile-vision__card li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    padding: 0.7rem 0;
    border-top: 1px solid #e4ebed;
    counter-increment: mission;
  }

  .profile-vision__card li::before {
    content: counter(mission, decimal-leading-zero);
    color: #4c8b82;
    font-size: 0.68rem;
    font-weight: 800;
  }

  .profile-structure {
    padding: clamp(4.75rem, calc(2.75rem + 4.1667vw), 6.5rem) 0;
    background: #fff;
  }

  .profile-structure__intro {
    max-width: 570px;
    margin: 1.25rem auto 0;
    color: #697680;
    font-size: 0.88rem;
    text-align: center;
  }

  .profile-org {
    max-width: 920px;
    margin: clamp(3.25rem, calc(2.9643rem + 0.5952vw), 3.5rem) auto 0;
  }

  .profile-org article {
    border: 1px solid #d5e0e2;
    background: #fff;
    text-align: center;
  }

  .profile-org__head {
    width: min(290px, 100%);
    margin-inline: auto;
    padding: 1.25rem;
  }

  .profile-org article > span {
    display: block;
    color: #56817d;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .profile-org article h3 {
    margin: 0.45rem 0 0;
    color: #2e414a;
    font-size: 0.98rem;
  }

  .profile-org article > p {
    margin: 0.55rem 0 0;
    color: #76828a;
    font-size: 0.72rem;
    line-height: 1.55;
  }

  .profile-org__line--stem {
    width: 1px;
    height: 3rem;
    margin-inline: auto;
    background: #adc2c4;
  }

  .profile-org__branches {
    --profile-org-gap: 1rem;
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--profile-org-gap);
    padding-top: 1.5rem;
  }

  .profile-org__branches::before {
    position: absolute;
    top: 0;
    right: calc((100% - (2 * var(--profile-org-gap))) / 6);
    left: calc((100% - (2 * var(--profile-org-gap))) / 6);
    height: 1px;
    content: '';
    background: #adc2c4;
  }

  .profile-org__branches > article {
    position: relative;
    z-index: 1;
    min-width: 0;
    padding: 1.35rem 1rem;
  }

  .profile-org__branches > article::before {
    position: absolute;
    top: -1.5rem;
    left: 50%;
    width: 1px;
    height: 1.5rem;
    content: '';
    background: #adc2c4;
  }

  .profile-org__territory > div {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.45rem;
    margin-top: 0.9rem;
  }

  .profile-org__territory > div p {
    margin: 0;
    padding: 0.5rem 0.25rem;
    color: #456b69;
    background: #edf5f5;
    font-size: 0.68rem;
    font-weight: 700;
  }

  .profile-structure__notes {
    display: grid;
    max-width: 920px;
    margin: 1.5rem auto 0;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .profile-structure__notes aside {
    padding: 1rem 1.2rem;
    border-left: 2px solid #8fb2b1;
    background: #f5f8f8;
  }

  .profile-structure__notes strong {
    color: #3e6665;
    font-size: 0.72rem;
    text-transform: uppercase;
  }

  .profile-structure__notes p {
    margin: 0.35rem 0 0;
    color: #6c7981;
    font-size: 0.74rem;
    line-height: 1.6;
  }

  @media (max-width: 760px) {
    .profile-container {
      width: min(100% - 2rem, 1100px);
    }

    .profile-hero {
      min-height: 0;
    }

    .profile-hero__image {
      object-position: 58% center;
    }

    .profile-hero__content {
      padding-bottom: clamp(5rem, 14vh, 7rem);
    }

    .profile-hero h1 {
      max-width: 355px;
      font-size: clamp(2.85rem, 13vw, 4.8rem);
      line-height: 1.08;
    }

    .profile-hero p {
      max-width: 340px;
      margin-top: 1.1rem;
      font-size: 0.92rem;
      line-height: 1.65;
    }

    .profile-history,
    .profile-landmark,
    .profile-vision,
    .profile-structure {
      scroll-margin-top: 80px;
    }

    .profile-history { padding: 3.5rem 0; }
    .profile-landmark { padding: 3.25rem 0; }
    .profile-vision { padding: 3.5rem 0; }
    .profile-structure { padding: 3.75rem 0; }

    .profile-history__layout,
    .profile-landmark__layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .profile-history__visual {
      grid-row: 1;
    }

    .profile-history__content {
      grid-row: 2;
    }

    .profile-history__visual img {
      height: min(118vw, 500px);
    }

    .profile-history h2,
    .profile-landmark h2,
    .profile-vision h2,
    .profile-structure h2 {
      font-size: clamp(2.15rem, 10vw, 3.3rem);
    }

    .profile-history__content > p:not(.profile-eyebrow),
    .profile-landmark__content > p:not(.profile-eyebrow) {
      margin-top: 1rem;
      font-size: 0.87rem;
      line-height: 1.75;
    }

    .profile-territory {
      grid-template-columns: 1fr;
      margin-top: 1.5rem;
    }

    .profile-territory__history {
      grid-column: auto;
    }

    .profile-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-top: 1.5rem;
    }

    .profile-stats article {
      padding: 0.9rem;
    }

    .profile-landmark__collage {
      height: min(116vw, 490px);
      gap: 0.5rem;
    }

    .profile-landmark__content {
      padding-bottom: 0.25rem;
    }

    .profile-facilities {
      margin-top: 1.5rem;
      gap: 0.5rem;
    }

    .profile-facilities li {
      padding: 0.55rem 0.75rem;
      font-size: 0.68rem;
    }

    .profile-vision__cards,
    .profile-structure__notes {
      grid-template-columns: 1fr;
    }

    .profile-vision__cards {
      gap: 0.9rem;
      margin-top: 2.25rem;
    }

    .profile-vision__card {
      padding: 1.5rem;
    }

    .profile-vision__card h3 {
      margin-top: 1rem;
    }

    .profile-org {
