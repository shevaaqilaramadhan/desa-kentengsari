---
import SiteLayout from '../layouts/SiteLayout.astro';

const stats = [
  { value: '1.201', label: 'Total Penduduk', detail: 'Data resmi tahun 2025' },
  { value: '626', label: 'Pria', detail: 'Penduduk pria tahun 2025' },
  { value: '575', label: 'Wanita', detail: 'Penduduk wanita tahun 2025' },
  { value: '390', label: 'Kepala Keluarga', detail: 'Jumlah KK tahun 2025' },
];

const missions = [
  ['01', 'Pelayanan publik', 'Meningkatkan kualitas pelayanan publik yang transparan, cepat, dan akuntabel.'],
  ['02', 'Ekonomi produktif', 'Mengembangkan sektor pertanian dan ekonomi produktif sebagai tulang punggung kesejahteraan warga.'],
  ['03', 'Gotong royong', 'Memperkuat kerukunan dan kearifan lokal dalam kehidupan bermasyarakat.'],
  ['04', 'Alam berkelanjutan', 'Melestarikan lingkungan dan potensi alam lereng Gunung Sumbing.'],
  ['05', 'Generasi masa depan', 'Meningkatkan kualitas sumber daya manusia melalui pendidikan dan pemberdayaan pemuda.'],
] as const;
---

<SiteLayout title="Profil Desa — Desa Kentengsari" description="Profil Desa Kentengsari: data penduduk 2025, dua wilayah administratif, tiga sebutan dusun warga, sejarah, dan struktur pemerintahan desa." activeRoute="profil-desa" canonicalPath="/profil-desa.html">
  <main id="main-content" class="profile-page">
    <section class="profile-hero" data-page-hero aria-labelledby="profile-title">
      <img src="/assets/hero-background.jpg" alt="Pemandangan Desa Kentengsari di lereng Gunung Sumbing" class="profile-hero__image" />
      <div class="profile-hero__veil"></div>
      <div class="profile-hero__grid"></div>
      <div class="profile-hero__content">
        <p class="profile-kicker profile-reveal">Profil Desa <span>/</span> Windusari, Magelang</p>
        <h1 id="profile-title" class="profile-hero__title profile-reveal">Satu desa.<br /><em>Seribu cerita.</em></h1>
        <p class="profile-hero__lead profile-reveal">Mengenal Kentengsari lebih dekat—dari jejak sejarah, tanah yang subur, hingga semangat warga yang menghidupkannya.</p>
        <a class="profile-hero__cta profile-reveal" href="#sejarah">Jelajahi cerita desa <span aria-hidden="true">↓</span></a>
      </div>
      <div class="profile-hero__aside profile-reveal" aria-label="Informasi singkat lokasi">
        <span class="profile-hero__aside-line"></span><span>LERENG GUNUNG SUMBING</span><strong>750<small> mdpl</small></strong>
      </div>
      <div class="profile-hero__scroll">Scroll untuk menjelajah <span></span></div>
    </section>

    <nav class="profile-rail" aria-label="Bagian halaman profil">
      <a href="#sejarah" class="is-active">01 <span>Sejarah</span></a><a href="#statistik">02 <span>Angka</span></a><a href="#visi-misi">03 <span>Visi & Misi</span></a><a href="#struktur">04 <span>Pemerintahan</span></a>
    </nav>

    <section class="profile-story profile-section" id="sejarah">
      <div class="profile-container profile-story__layout">
        <div class="profile-story__copy profile-reveal">
          <p class="profile-kicker profile-kicker--dark">01 / Sejarah & gambaran umum</p>
          <h2>Dari Kenteng<br /><span>dan Sari</span></h2>
          <p>Nama Desa Kentengsari merupakan penggabungan dari dua nama desa pendahulunya, yaitu Desa Kenteng dan Desa Sari. Penggabungan ini melahirkan satu kesatuan wilayah administratif yang kini dikenal sebagai Kentengsari.</p>
          <p>Berada di Kecamatan Windusari, Kabupaten Magelang, desa ini terletak di lereng Gunung Sumbing. Udara sejuk dan tanah yang subur menjadi anugerah yang dimanfaatkan masyarakat untuk bertani padi, tembakau, sayuran, dan berbagai komoditas pertanian lainnya.</p>
          <div class="profile-story__coordinates"><span>LERENG GUNUNG SUMBING</span><span class="profile-story__rule"></span><span>MAGELANG, JAWA TENGAH</span></div>
        </div>
        <figure class="profile-story__visual profile-reveal">
          <div class="profile-story__image-wrap"><img src="/assets/profil-desa-image.jpg" alt="Panorama wilayah Desa Kentengsari di lereng Gunung Sumbing" loading="lazy" /></div>
          <figcaption><strong>2,5</strong><span>km dari ibu kota<br />kecamatan</span></figcaption>
          <span class="profile-story__stamp">KENTENGSARI<br /><small>RUMAH BERSAMA</small></span>
        </figure>
      </div>
    </section>

    <section class="profile-numbers profile-section" id="statistik">
      <div class="profile-container">
        <div class="profile-section-head profile-reveal"><div><p class="profile-kicker">02 / Data penduduk 2025</p><h2>Kentengsari <span>Dalam Angka</span></h2></div><p>Data resmi kependudukan Desa Kentengsari tahun 2025.</p></div>
        <div class="profile-stat-grid">{stats.map((stat, index) => <article class="profile-stat profile-reveal" style={`--delay: ${index * 80}ms`}><span class="profile-stat__index">0{index + 1}</span><strong>{stat.value}</strong><h3>{stat.label}</h3><p>{stat.detail}</p></article>)}</div>
      </div>
    </section>

    <section class="profile-territory profile-section" id="wilayah" aria-labelledby="wilayah-heading">
      <div class="profile-container">
        <div class="profile-section-head profile-reveal"><div><p class="profile-kicker profile-kicker--dark">03 / Pembagian wilayah</p><h2 id="wilayah-heading">Dua Administratif, <span>Tiga Sebutan Warga</span></h2></div><p>Pembagian pemerintah dan sebutan yang hidup di tengah warga dipakai untuk konteks yang berbeda, sehingga keduanya bukan informasi yang bertentangan.</p></div>
        <div class="profile-territory__grid profile-reveal">
          <article class="profile-territory__card profile-territory__card--admin">
            <p class="profile-kicker profile-kicker--dark">Administratif Pemerintah</p>
            <h3>2 Wilayah Kewilayahan</h3>
            <p>Nama kewilayahan setelah mengikuti peraturan bupati baru:</p>
            <ul aria-label="Wilayah administratif pemerintah"><li>Kentengsari 1</li><li>Kentengsari 2</li></ul>
          </article>
          <article class="profile-territory__card">
            <p class="profile-kicker profile-kicker--dark">Sebutan yang Hidup di Warga</p>
            <h3>3 Sebutan Dusun</h3>
            <p>Dalam percakapan dan kehidupan sehari-hari, warga mengenal:</p>
            <ul class="profile-territory__community" aria-label="Sebutan dusun warga"><li>Nglarangan</li><li>Kentengsari</li><li>Kenteng Wetan</li></ul>
          </article>
        </div>
        <aside class="profile-territory__history profile-reveal" aria-label="Riwayat penataan wilayah"><strong>Riwayat sebelum penataan organisasi desa:</strong> wilayah pernah dinyatakan sebagai Krajan 1, Krajan 2, dan Krajan 3. Nama-nama tersebut dicatat sebagai riwayat, bukan nama kewilayahan administratif yang berlaku saat ini.</aside>
      </div>
    </section>

    <section class="profile-facilities profile-section" id="landmark" aria-labelledby="landmark-heading">
      <div class="profile-container">
        <div class="profile-section-head profile-reveal"><div><p class="profile-kicker profile-kicker--dark">Sarana desa</p><h2 id="landmark-heading">Landmark &amp; Sarana Umum</h2></div><p>Fasilitas yang menjadi pusat kegiatan, pelayanan, dan ruang hidup masyarakat Desa Kentengsari.</p></div>
        <div class="profile-facilities__grid profile-reveal">
          <article><h3>Kantor Desa</h3><p>Pusat pelayanan administrasi dan informasi bagi masyarakat.</p></article>
          <article><h3>Sekolah Dasar</h3><p>Fasilitas pendidikan dasar bagi putra-putri desa.</p></article>
          <article><h3>Tempat Ibadah</h3><p>Ruang kegiatan rohani masyarakat.</p></article>
          <article><h3>Lahan Pertanian</h3><p>Hamparan sawah dan kebun yang mendukung ekonomi desa.</p></article>
          <article><h3>Drainase &amp; Irigasi</h3><p>Sarana aliran air yang mendukung lingkungan permukiman dan lahan pertanian desa.</p></article>
        </div>
      </div>
    </section>

    <section class="profile-vision profile-section" id="visi-misi">
      <div class="profile-container profile-vision__layout">
        <div class="profile-vision__statement profile-reveal"><p class="profile-kicker profile-kicker--light">03 / Arah pembangunan</p><p class="profile-vision__eyebrow">Visi Desa</p><blockquote>“Maju, mandiri, dan sejahtera—berlandaskan gotong royong serta kearifan lokal masyarakat lereng Gunung Sumbing.”</blockquote><span class="profile-vision__signature">— Pemerintah Desa Kentengsari</span></div>
        <div class="profile-mission profile-reveal"><p class="profile-kicker profile-kicker--dark">Misi kami</p><h2>Langkah nyata,<br /><span>setiap hari.</span></h2><div class="profile-mission__list">{missions.map((mission) => <article><span>{mission[0]}</span><div><h3>{mission[1]}</h3><p>{mission[2]}</p></div></article>)}</div></div>
      </div>
    </section>

    <section class="profile-structure profile-section" id="struktur" aria-labelledby="struktur-heading">
      <div class="profile-container">
        <div class="profile-section-head profile-reveal"><div><p class="profile-kicker profile-kicker--dark">04 / Pemerintahan desa · Struktur Organisasi</p><h2 id="struktur-heading">Yang melayani,<br /><span>yang menggerakkan.</span></h2></div><p>Struktur pemerintahan adalah ruang kolaborasi untuk memastikan pelayanan hadir lebih dekat bagi setiap warga.</p></div>
        <div class="profile-org profile-hierarchy profile-reveal" role="group" aria-label="Bagan hierarki pemerintahan Desa Kentengsari">
          <article class="profile-org__lead"><span>Level Utama</span><h3>Kepala Desa</h3><p>Pimpinan pemerintahan desa</p></article>
          <div class="profile-org__connector"></div>
          <div class="profile-hierarchy__branches" aria-label="Unsur di bawah Kepala Desa">
            <article class="profile-hierarchy__card"><span>Administrasi</span><h3>Sekretaris Desa</h3><p>Koordinasi administrasi pemerintahan desa.</p></article>
            <article class="profile-hierarchy__card"><span>Pelaksana Teknis</span><h3>Kaur &amp; Kasi</h3><p>Unsur urusan dan seksi pelaksana teknis.</p></article>
            <article class="profile-hierarchy__card profile-hierarchy__territory"><span>Pelaksana Kewilayahan</span><h3>Kepala Kewilayahan</h3><p>Pelaksana pemerintahan pada wilayah administratif desa.</p><div class="profile-hierarchy__territories" aria-label="Wilayah administratif di bawah Kepala Kewilayahan"><article><h4>Kentengsari 1</h4></article><article><h4>Kentengsari 2</h4></article></div></article>
          </div>
        </div>
        <div class="profile-structure__notes profile-reveal">
          <aside><strong>Sebutan Warga</strong><p>Nglarangan, Kentengsari, dan Kenteng Wetan adalah tiga sebutan dusun yang hidup di tengah warga; ketiganya tidak menggantikan dua nama administratif pada bagan.</p></aside>
          <aside><strong>Catatan Riwayat</strong><p>Krajan 1, Krajan 2, dan Krajan 3 merupakan pernyataan wilayah sebelum penataan organisasi desa, bukan nama kewilayahan administratif saat ini.</p></aside>
        </div>
      </div>
    </section>

    <section class="profile-endcap"><div class="profile-container"><p class="profile-kicker profile-kicker--light">Kentengsari / Rumah bersama</p><h2>Tempat cerita<br /><em>terus tumbuh.</em></h2><a href="/kontak.html">Hubungi pemerintah desa <span>→</span></a></div></section>
  </main>
</SiteLayout>

<script>
  const revealItems = document.querySelectorAll('.profile-reveal');
  const observer = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); } }), { threshold: 0.12 });
  revealItems.forEach((item) => observer.observe(item));
  const sections = document.querySelectorAll('.profile-section');
  const railLinks = document.querySelectorAll('.profile-rail a');
  const sectionObserver = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) railLinks.forEach((link) => link.classList.toggle('is-active', link.getAttribute('href') === `#${entry.target.id}`)); }), { rootMargin: '-35% 0px -55% 0px' });
  sections.forEach((section) => sectionObserver.observe(section));
</script>

<style>
  /* Keep the editorial hero within the shared page-hero geometry used by the site. */
  .profile-page .profile-hero[data-page-hero] {
    height: 385px;
    min-height: 385px;
  }

  .profile-territory,
  .profile-facilities {
    padding: 7rem 0;
  }

  .profile-territory {
    background: #f8f7f2;
  }

  .profile-territory .profile-section-head h2,
  .profile-facilities .profile-section-head h2 {
    color: #153a26;
  }

  .profile-territory__grid,
  .profile-facilities__grid,
  .profile-structure__notes {
    display: grid;
    gap: 1.25rem;
    margin-top: 4rem;
  }

  .profile-territory__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .profile-territory__card,
  .profile-facilities__grid article,
  .profile-structure__notes aside {
    min-width: 0;
    padding: 1.75rem;
    border: 1px solid #cbdacb;
    background: rgb(255 255 255 / .72);
    box-shadow: 0 10px 25px rgb(28 91 56 / .06);
  }

  .profile-territory__card--admin {
    background: #eef3ea;
  }

  .profile-territory__card h3,
  .profile-facilities__grid h3 {
    margin: 1rem 0 .45rem;
    color: #173e26;
    font-size: 1.15rem;
    font-weight: 800;
  }

  .profile-territory__card > p:not(.profile-kicker),
  .profile-facilities__grid p,
  .profile-structure__notes p {
    margin: 0;
    color: #68766d;
    font-size: .85rem;
    line-height: 1.75;
  }

  .profile-territory__card ul {
    display: grid;
    gap: .7rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .profile-territory__card li {
    padding: .85rem 1rem;
    border: 1px solid #d2e0d1;
    background: #fff;
    color: #173e26;
    font-size: .85rem;
    font-weight: 800;
  }

  .profile-territory__community {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .profile-territory__community li {
    text-align: center;
  }

  .profile-territory__history {
    margin-top: 1.5rem;
    padding: 1.25rem 1.5rem;
    border-left: 4px solid #2c8050;
    background: #eef3ea;
    color: #68766d;
    font-size: .85rem;
    line-height: 1.75;
  }

  .profile-territory__history strong,
  .profile-structure__notes strong {
    color: #173e26;
  }

  .profile-facilities {
    background: #fff;
  }

  .profile-facilities__grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .profile-facilities__grid article:last-child {
    background: #eef3ea;
  }

  .profile-hierarchy__branches {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .profile-hierarchy__branches::before {
    position: absolute;
    top: -1px;
    right: 16.66%;
    left: 16.66%;
    height: 1px;
    content: '';
    background: #94b79b;
  }

  .profile-hierarchy__card {
    min-width: 0;
    padding: 1.5rem;
    border: 1px solid #cbdacb;
    background: rgb(255 255 255 / .72);
    text-align: left;
  }

  .profile-hierarchy__card h3,
  .profile-org__lead h3 {
    margin: .45rem 0 .25rem;
    color: #173e26;
    font-size: 1rem;
    font-weight: 800;
  }

  .profile-org__lead h3 {
    color: #fff;
    font-size: 1.2rem;
  }

  .profile-hierarchy__card p,
  .profile-org__lead p {
    margin: 0;
    color: #68766d;
    font-size: .8rem;
    line-height: 1.65;
  }

  .profile-org__lead p {
    color: rgb(255 255 255 / .68);
  }

  .profile-hierarchy__territories {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .65rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid #cbdacb;
  }

  .profile-hierarchy__territories article {
    padding: .7rem .5rem;
    border: 1px solid #d2e0d1;
    background: #eef3ea;
    text-align: center;
  }

  .profile-hierarchy__territories h4 {
    margin: 0;
    color: #173e26;
    font-size: .75rem;
    font-weight: 800;
  }

  .profile-structure__notes {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 3rem;
  }

  .profile-structure__notes strong {
    display: block;
    margin-bottom: .45rem;
    color: #2c8050;
    font-size: .7rem;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  @media (max-width: 760px) {
    .profile-page .profile-hero[data-page-hero] {
      height: 468px;
      min-height: 468px;
    }

    .profile-territory,
    .profile-facilities {
      padding: 6rem 0;
    }

    .profile-territory__grid,
    .profile-facilities__grid,
    .profile-hierarchy__branches,
    .profile-structure__notes {
      grid-template-columns: 1fr;
    }

    .profile-territory__community {
      grid-template-columns: 1fr;
    }

    .profile-hierarchy__branches::before {
      display: none;
    }

    .profile-hierarchy__territories {
      grid-template-columns: 1fr;
    }
  }
</style>
