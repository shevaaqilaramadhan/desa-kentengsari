---
interface Props {
  title: string;
  description: string;
  current: string;
}

const { title, description, current } = Astro.props;
---

<section data-page-hero class="relative isolate flex min-h-[29rem] items-center overflow-hidden bg-kenteng-950 pb-16 pt-28 text-center text-white sm:min-h-96 sm:pb-16 sm:pt-24">
  <img class="absolute inset-0 -z-20 h-full w-full object-cover" src="/assets/hero-background.jpg" alt="" />
  <div class="absolute inset-0 -z-10 bg-kenteng-950/75"></div>
  <div class="relative mx-auto w-[min(1140px,calc(100%-2rem))]">
    <p class="mb-4 text-xs font-extrabold uppercase tracking-[0.16em] text-kenteng-100">
      <a class="transition-colors hover:text-white" href="/index.html">Beranda</a>
      <span aria-hidden="true"> / </span>{current}
    </p>
    <h1 class="mx-auto max-w-4xl text-[2rem] font-extrabold leading-[1.2] tracking-tight sm:text-4xl lg:text-5xl">{title}</h1>
    <p class="mx-auto mt-4 max-w-3xl text-sm leading-7 text-white/85 sm:text-base">{description}</p>
  </div>
</section>
