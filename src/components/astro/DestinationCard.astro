---
interface Props {
  image: string;
  alt: string;
  tag: string;
  title: string;
  description: string;
}

const { image, alt, tag, title, description } = Astro.props;
---

<article class="group relative min-h-[420px] overflow-hidden rounded-panel bg-kenteng-950 shadow-card">
  <img class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" src={image} alt={alt} loading="lazy" />
  <div class="absolute inset-0 bg-gradient-to-t from-kenteng-950 via-kenteng-950/50 to-transparent"></div>
  <div class="absolute inset-x-0 bottom-0 p-6 text-white md:p-8">
    <span class="inline-flex rounded-full bg-kenteng-500/90 px-3 py-1 text-xs font-extrabold uppercase tracking-wider">{tag}</span>
    <h3 class="mt-3 text-2xl font-extrabold">{title}</h3>
    <p class="mt-2 leading-7 text-white/80">{description}</p>
  </div>
</article>
