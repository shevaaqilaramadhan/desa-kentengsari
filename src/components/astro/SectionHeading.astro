---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  centered?: boolean;
  headingId?: string;
}

const { eyebrow, title, description, centered = false, headingId } = Astro.props;
---

<div class:list={[centered && 'mx-auto max-w-3xl text-center']}>
  <p class="text-sm font-extrabold uppercase tracking-[0.16em] text-kenteng-700">{eyebrow}</p>
  <h2 id={headingId} class="mt-3 text-3xl font-extrabold tracking-tight text-kenteng-950 md:text-4xl">{title}</h2>
  {description && <p class="mt-4 text-base leading-8 text-muted md:text-lg">{description}</p>}
</div>
